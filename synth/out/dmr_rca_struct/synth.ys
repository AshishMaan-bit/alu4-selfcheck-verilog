# auto-generated by scripts/run_synth.py : dmr rca struct
read_verilog -Irtl rtl/adder4.v rtl/alu4_datapath.v rtl/alu4_checker.v rtl/alu4_datapath_bs.v rtl/alu4_sc_core.v rtl/alu4_dmr_core.v rtl/alu4_base_core.v
chparam -set ADDER_ARCH 0 alu4_dmr_core
hierarchy -check -top alu4_dmr_core
setattr -mod -set keep_hierarchy 1 *alu4_datapath* *alu4_checker* *alu4_rslice* *alu4_cslice* *alu4_vslice*
synth -flatten -top alu4_dmr_core -noabc
setattr -mod -unset keep_hierarchy
flatten
opt_clean -purge
tee -o synth/out/dmr_rca_struct/stat.txt stat
tee -a synth/out/dmr_rca_struct/stat.txt ltp -noff
